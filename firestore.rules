rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per allowed member; document ID = exact Google account email.
    // Clients may read only their own allowlist doc (to verify membership).
    match /member_allowlist/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }
  }
}
